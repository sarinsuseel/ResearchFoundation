# ASRF Research Platform Configuration
PORT=8080
BASE_URL=http://localhost:8080

# Database (Uses embedded pure-Go SQLite by default for instant zero-dependency running)
DB_TYPE=sqlite
DB_PATH=./data/asrf.db

# Admin Notification Settings
# When a researcher submits an article, an alert goes to this email:
ADMIN_EMAIL=admin@researchplatform.com

# SMTP Email Dispatch Settings (Gmail App Password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Upload Directory for Manuscripts
UPLOAD_DIR=./uploads
